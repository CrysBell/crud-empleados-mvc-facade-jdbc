<meta charset="UTF-8">
<title>Formulario</title>
</head>
<body>
	<h1>Formulario de Alta/Modificación de Empleado</h1>
	

	<fieldset>
		<leyend>Formulario de gestión de empleados</leyend>
		
		<form action="#" method="get" >
			<label for="nombre">Nombre:</label>
			<input id="nombre" name="nombre" placeholder="Escribe tu nombre aquí">
			
			<label for="primerApellido">Primer apellido:</label>
			<input id="primerApellido" name="primerApellido" placeholder="Escribe tu primer apellido aquí">
			
			<input type="submit" value="Actualizar">
		</form>
		
	</fieldset>		
	
	
</body>
